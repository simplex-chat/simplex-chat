[listener]
host = 0.0.0.0
port = 8080
static_dir = /srv/web
trust_forwarded_for = off

[btcpay]
host = https://btcpay.example.org
api_key = replace-me
store_id = replace-me
webhook_secret = replace-me
expiry_minutes = 60
speed_policy = MediumSpeed
payment_tolerance = 0.5

; optional; omit the whole [stripe] section to disable card payments
[stripe]
; restricted key (rk_): Checkout Sessions write + PaymentIntents/Charges read — never a full secret key (sk_)
secret_key = rk_test_replace-me
publishable_key = pk_test_replace-me
; the signing secret of the /webhooks/stripe endpoint configured in the Dashboard
webhook_secret = whsec_replace-me
; a fixed address sent as customer_email so buyers never enter one (Stripe requires an email to
; confirm); use an address you own with receipts turned off, never one derived from the order id
receipt_email = noreply@example.org
; minutes until an unpaid checkout session expires; 31-1439 (a minute inside Stripe's 30-minute-to-24-hour window)
session_minutes = 60

[poll]
waiting_seconds = 3
idle_seconds = 60

[issuer]
default = key_1
key_1 = replace-me

[dev]
chat_redeem = on
