# Copy to config.toml. Each key sets the command-line option named next to it;
# an option given on the command line takes precedence.

[bot]
team_group = "SimpleX Support Team"            # --team-group
auto_add_team_members = ["1:Alice"]            # --auto-add-team-members
state_file = "/data/state.json"                # --state-file
timezone = "UTC"                               # --timezone
# complete_hours = 3                           # --complete-hours
# card_flush_seconds = 300                     # --card-flush-seconds
# queue_size = 65536                           # --queue-size, core default 1024

[database]
type = "postgres"                              # --db
pg_conn = "postgres://simplex@127.0.0.1/simplex_support_bot"   # --pg-conn
# pg_schema = "simplex_v1"                     # --pg-schema

[grok]
context_file = "/etc/support-bot/grok-context.yaml"   # --context-file
# Enables Grok replies; GROK_API_KEY takes precedence.
# api_key = "xai-..."

# A message left out keeps its built-in text.
# {hours} is 24 on weekdays and 48 at weekends in bot.timezone.
[messages]
welcome = """
Hello! This is a *SimpleX team* support bot - not an AI.
Discover public groups: [simplex.chat/directory](https://simplex.chat/directory)

Please ask any questions about SimpleX Chat."""
queue = "The team will reply to your message within {hours} hours."
