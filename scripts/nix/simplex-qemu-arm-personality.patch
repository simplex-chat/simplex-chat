+#if defined(TARGET_ARM) && !defined(TARGET_AARCH64)
+/*
+ * Android's ARM32 libc requests PER_LINUX32 during startup.  An ARM64 host
+ * without AArch32 EL0 rejects that execution domain even though TCG can run
+ * the guest.  QEMU already provides the guest architecture for uname().
+ *
+ * Only substitute the execution domain after the host rejects it with EINVAL.
+ * Keep every upper flag host-backed, and retain the full guest value so query
+ * and setter return values do not expose the substituted host domain.  This
+ * per-task state is copied by clone; a new Android exec initializes it again
+ * when libc sets its personality.
+ */
+static abi_long do_arm32_personality(CPUState *cpu, uint32_t value)
+{
+    TaskState *ts = get_task_state(cpu);
+    uint32_t previous = ts->guest_personality;
+    bool virtualized = ts->guest_personality_virtualized;
+    int ret = personality(value);
+
+    if (ret == -1 && errno == EINVAL && (value & PER_MASK) == PER_LINUX32) {
+        ret = personality((value & ~PER_MASK) | PER_LINUX);
+        if (ret != -1) {
+            ts->guest_personality = value;
+            ts->guest_personality_virtualized = true;
+            return virtualized ? previous : (uint32_t)ret;
+        }
+    }
+    if (ret == -1) {
+        return get_errno(ret);
+    }
+    if (value != UINT32_MAX) {
+        ts->guest_personality_virtualized = false;
+    }
+    return virtualized ? previous : (uint32_t)ret;
+}
+#endif
