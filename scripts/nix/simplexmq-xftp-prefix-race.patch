@@ -174,8 +173,20 @@
 getPrefixPath suffix = do
   workPath <- getXFTPWorkPath
   ts <- liftIO getCurrentTime
-  let isoTime = formatTime defaultTimeLocale "%Y%m%d_%H%M%S_%6q" ts
-  uniqueCombine workPath (isoTime <> "_" <> suffix)
+  let base = formatTime defaultTimeLocale "%Y%m%d_%H%M%S_%6q" ts <> "_" <> suffix
+  -- uniqueCombine only checks. Two prepares in one clock tick both see a
+  -- free path, and the second createDirectory throws. Claim the directory
+  -- here and pick another name if this one was taken.
+  claim workPath base (0 :: Int)
+  where
+    claim workPath base n = do
+      let named = if n == 0 then base else base <> "_" <> show n
+      path <- uniqueCombine workPath named
+      liftIO (try @IOException $ createDirectory path) >>= \case
+        Right () -> pure path
+        Left e
+          | isAlreadyExistsError e, n < 100 -> claim workPath base (n + 1)
+          | otherwise -> liftIO $ throwIO e
 
 toFSFilePath :: FilePath -> AM' FilePath
 toFSFilePath f = (</> f) <$> getXFTPWorkPath
