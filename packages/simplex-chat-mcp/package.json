    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplex-chat/simplex-chat.git",
    "directory": "packages/simplex-chat-mcp"
  },
  "keywords": [
