{
  "name": "@simplex-chat/mcp",
  "version": "0.2.0",
  "description": "Claude Code plugin: each session chats on SimpleX with its own profile, approved in your app",
  "bin": {
    "simplex-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".claude-plugin",
    ".mcp.json",
    "hooks",
    "plugin",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
