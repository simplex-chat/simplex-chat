{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/launch.js\" hook session-start", "timeout": 600}]}],
    "PreToolUse": [{"matcher": "mcp__plugin_simplex_simplex__.*", "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/allow.js\""}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/launch.js\" hook turn", "async": true}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/launch.js\" hook turn", "async": true}]}],
    "PostModelSwitch": [{"hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugin/launch.js\" hook turn", "async": true}]}]
  }
}
