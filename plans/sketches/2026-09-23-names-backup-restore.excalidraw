    {"id":"te112293791211","type":"text","x":78.7,"y":1902.7,"width":169.89545454545456,"height":11.25,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["importno","band-refusals"],"index":"b5q","text":"reclaim names from my recovery key","fontSize":9,"fontFamily":9,"lineHeight":1.25},
    {"id":"te840756511447","type":"text","x":76.6,"y":1927,"width":172.0,"height":20.000000000000004,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["importno","band-refusals"],"index":"b5r","text":"Alice is hidden, and hidden profiles cannot\nown names. Switch to another profile first.","fontSize":8,"fontFamily":9,"lineHeight":1.25},
    {"id":"re501871172114","type":"rectangle","x":234,"y":1774,"width":35,"height":15,"strokeColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["importno","band-refusals"],"index":"b5t","backgroundColor":"#34c759","roundness":{"type":3}},
