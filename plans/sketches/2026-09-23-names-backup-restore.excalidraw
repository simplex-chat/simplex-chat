    {"id":"re760737142486","type":"rectangle","x":940,"y":1790,"width":209,"height":150,"strokeColor":"#d9dbe0","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"roughness":0,"groupIds":["migrate","band-refusals"],"roundness":{"type":3},"index":"b6b"},
    {"id":"te110193386513","type":"text","x":952,"y":1804,"width":153.92,"height":14.75,"strokeColor":"#1c1e26","fillStyle":"solid","strokeWidth":1,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6c","text":"Migrate to another device","fontSize":11.8,"fontFamily":2,"lineHeight":1.25},
    {"id":"te595711455067","type":"text","x":952,"y":1828,"width":185.64,"height":10.88,"strokeColor":"#6d6d72","fillStyle":"solid","strokeWidth":1,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6d","text":"The key moves with the chat database, so","fontSize":8.7,"fontFamily":2,"lineHeight":1.25},
