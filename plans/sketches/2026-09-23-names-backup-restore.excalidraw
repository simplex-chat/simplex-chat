    {"id":"te690171067320","type":"text","x":1380,"y":1183.7,"width":188.29,"height":16.25,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["found","band-restore"],"index":"b5B","text":"8.  Found, and where to stop","fontSize":13,"fontFamily":9,"lineHeight":1.25},
    {"id":"te243945197773","type":"text","x":1380,"y":1200.4,"width":252.99,"height":68.75,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["found","band-restore"],"index":"b5C","text":"The search stops after 20 unused keys in a\nrow, at most 200, so a gap can hide a name:\nLook further runs 7 on from where it stopped.\nNeeds core: the scan takes no start yet.\nDone opens the hub (2) with the names.","fontSize":11,"fontFamily":9,"lineHeight":1.25},
    {"id":"te910303696798","type":"text","x":1396.6,"y":1330.9,"width":94.35588235294118,"height":8.750000000000002,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["foundnone","band-restore"],"index":"b5I","text":"WHEN NOTHING IS FOUND","fontSize":7,"fontFamily":9,"lineHeight":1.25},
    {"id":"re834229173859","type":"rectangle","x":1388.3,"y":1343,"width":192.4,"height":29.1,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["foundnone","band-restore"],"index":"b5J"},
    {"id":"te586672587245","type":"text","x":1398.7,"y":1353.4,"width":99.7875,"height":11.25,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["foundnone","band-restore"],"index":"b5K","text":"No names for this key","fontSize":9,"fontFamily":9,"lineHeight":1.25},
    {"id":"te775283573567","type":"text","x":1396.6,"y":1377.7,"width":161.41538461538462,"height":20.000000000000004,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["foundnone","band-restore"],"index":"b5L","text":"It may be a key from another app, or its\nnames expired and were taken.","fontSize":8,"fontFamily":9,"lineHeight":1.25},
    {"id":"te529190915670","type":"text","x":1396.6,"y":1398.5,"width":50.04102564102565,"height":10.000000000000002,"strokeColor":"#007aff","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["foundnone","band-restore"],"index":"b5N","text":"Look further","fontSize":8,"fontFamily":9,"lineHeight":1.25},
