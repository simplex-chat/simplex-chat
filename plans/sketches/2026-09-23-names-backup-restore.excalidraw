    {"id":"te498057748184","type":"text","x":78.7,"y":1818.4,"width":169.89545454545456,"height":11.25,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["importno","band-refusals"],"index":"b5k","text":"reclaim names from my recovery key","fontSize":9,"fontFamily":9,"lineHeight":1.25},
    {"id":"te484170944707","type":"text","x":76.6,"y":1842.7,"width":180.49230769230772,"height":30.000000000000004,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["importno","band-refusals"],"index":"b5l","text":"This device already has a recovery key. It\nprotects dynamis.simplex and 1 more, and a\ndevice holds one key.","fontSize":8,"fontFamily":9,"lineHeight":1.25},
    {"id":"te379726851361","type":"text","x":76.6,"y":1873.9,"width":55.11794871794873,"height":10.000000000000002,"strokeColor":"#007aff","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["importno","band-refusals"],"index":"b5o","text":"Show the key","fontSize":8,"fontFamily":9,"lineHeight":1.25},
