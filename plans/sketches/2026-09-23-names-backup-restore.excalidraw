    {"id":"te970865984000","type":"text","x":500,"y":2085.9,"width":247,"height":16.25,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["dbrestored","band-refusals"],"index":"b6V","text":"10.  After restoring an older database","fontSize":13,"fontFamily":9,"lineHeight":1.25},
    {"id":"te150030018615","type":"text","x":500,"y":2102.6,"width":251.29,"height":68.75,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["dbrestored","band-refusals"],"index":"b6W","text":"An older database's key counter is behind,\nso the next name could reuse a key that\nalready owns one. Needs core: importing a\ndatabase must clear the counter (wallet-keys\nRFC, limit 9). Nothing does this yet.","fontSize":11,"fontFamily":9,"lineHeight":1.25},
    {"id":"re760737142486","type":"rectangle","x":940,"y":1790,"width":209,"height":150,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6b"},
    {"id":"te110193386513","type":"text","x":952,"y":1804,"width":156.528813559322,"height":15.0,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6c","text":"Migrate to another device","fontSize":12,"fontFamily":9,"lineHeight":1.25},
    {"id":"te595711455067","type":"text","x":952,"y":1828,"width":201.78620689655173,"height":78.75,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6d","text":"The key moves with the chat database, so\nthe new device has nothing to restore and\nnothing is asked. The old device must stop:\ntwo devices with one key can register two\nnames to the same key. Migration already\nstops chat on the old device, and the names\nscreens there stop with it.","fontSize":9,"fontFamily":9,"lineHeight":1.25},
    {"id":"re550249579278","type":"rectangle","x":1114,"y":1774,"width":35,"height":15,"strokeColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6k","backgroundColor":"#34c759","roundness":{"type":3}},
    {"id":"te948238740212","type":"text","x":1120.66,"y":1776.8,"width":21.67,"height":12.5,"strokeColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6l","text":"new","fontSize":10,"fontFamily":9,"lineHeight":1.25},
    {"id":"te542513570823","type":"text","x":940,"y":1947,"width":205.89,"height":16.25,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6m","text":"11.  Migrating needs no restore","fontSize":13,"fontFamily":9,"lineHeight":1.25},
    {"id":"te950106557257","type":"text","x":940,"y":1963.7,"width":242,"height":27.5,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["migrate","band-refusals"],"index":"b6n","text":"A note, not a screen: the existing migration\nflow is unchanged.","fontSize":11,"fontFamily":9,"lineHeight":1.25},
    {"id":"ar305529312212","type":"arrow","x":720.2,"y":1874.53,"width":208.69999999999993,"height":710.0620000000004,"strokeColor":"#007aff","fillStyle":"solid","strokeWidth":2,"roughness":0,"boundElements":[{"id":"te211623012846","type":"text"}],"index":"b6p","points":[[0,0],[179.79999999999995,0],[179.79999999999995,-710.0620000000004],[208.69999999999993,-710.0620000000004]],"endArrowhead":"arrow","elbowed":true,"fixedSegments":null,"startBinding":{"elementId":"re432888659822","focus":0,"gap":8,"fixedPoint":[1.037157,0.3]},"endBinding":{"elementId":"re531455724066","focus":0,"gap":8,"fixedPoint":[-0.037157,0.92]}},
    {"id":"te211623012846","type":"text","x":825.89,"y":1512.5,"width":148.22,"height":14,"strokeColor":"#007aff","fillStyle":"solid","strokeWidth":2,"roughness":0,"index":"b6q","text":"Look for your names again","fontSize":11,"fontFamily":9,"textAlign":"center","verticalAlign":"middle","containerId":"ar305529312212","lineHeight":1.25},
    {"id":"te773348484242","type":"text","x":60,"y":2260,"width":1225.67,"height":41.25,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"index":"b6r","text":"Design document, not screenshots: screens are drawn in the app's iOS idiom, and alerts as the apps draw them. Tags compare with phase 2 (simplex-names-flow-phase2.svg): as phase 2, changed, new.\nThe key is the device wallet of the wallet-keys RFC (simplex-chat#7475): one BIP-39 master per device, 24 words, no passphrase, one account per name. Phase 2 drew 12 or 24 words and a picker of several keys; both go.\nNot drawn: a name managed elsewhere, as phase 2; exporting one name's key; deleting the key.","fontSize":11,"fontFamily":9,"lineHeight":1.25},
    {"id":"re271378363873","type":"rectangle","x":55,"y":613.8,"width":237.71,"height":23.75,"strokeColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["setup","band-backup"],"boundElements":[{"id":"te301433886319","type":"text"}],"index":"b6u","backgroundColor":"#ffeb3b","roundness":{"type":3}},
    {"id":"te301433886319","type":"text","x":60,"y":618.8,"width":189.76,"height":13.75,"strokeColor":"#1c1e26","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["setup","band-backup"],"index":"b6v","text":"see names-phase3a-registration 7","fontSize":11,"fontFamily":9,"verticalAlign":"middle","containerId":"re271378363873","lineHeight":1.25},
    {"id":"re769928807228","type":"rectangle","x":495,"y":646.3,"width":237.71,"height":23.75,"strokeColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["hub","band-backup"],"boundElements":[{"id":"te924309270633","type":"text"}],"index":"b6w","backgroundColor":"#ffeb3b","roundness":{"type":3}},
