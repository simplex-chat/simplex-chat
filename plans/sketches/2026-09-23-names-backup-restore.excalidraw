    {"id":"te899563259548","type":"text","x":60,"y":1962.8,"width":137.96,"height":16.25,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["importno","band-refusals"],"index":"b5v","text":"9.  Refused, and why","fontSize":13,"fontFamily":9,"lineHeight":1.25},
    {"id":"te917501476284","type":"text","x":60,"y":1979.5,"width":250.97,"height":68.75,"strokeColor":"#1e1e1e","fillStyle":"solid","strokeWidth":2,"roughness":0,"groupIds":["importno","band-refusals"],"index":"b5w","text":"The first row of 5, disabled. A device with\na key refuses a second one, as the wallet\ndoes, so the user is shown the key they\nhave: Show the key opens 3. A hidden profile\nbinds no key, so it cannot scan either.","fontSize":11,"fontFamily":9,"lineHeight":1.25},
