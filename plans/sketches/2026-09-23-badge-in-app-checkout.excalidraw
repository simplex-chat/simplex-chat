      "groupIds": [
        "A2",
        "lane1"
      ],
      "seed": 1216,
      "text": "Unchanged except where the price comes from: store.price()\nbecomes the catalog's monthPrice. The tiers stay app\nresources - BadgeLevel already holds the titles and the file\nsizes - so the catalog only prices them, and a level with no\nactive price is the disabled card this screen can already\ndraw.",
      "fontSize": 9,
      "fontFamily": 2,
