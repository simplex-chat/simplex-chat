    {"id": "b2-title", "type": "text", "x": 500, "y": 1196, "width": 260, "height": 24, "strokeColor": "#5b21b6", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B2", "lane2"], "seed": 2203, "text": "Check your order", "fontSize": 19, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a122"},
    {"id": "b2-rowsL", "type": "text", "x": 504, "y": 1270, "width": 160, "height": 36, "strokeColor": "#1c1e26", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B2", "lane2"], "seed": 2204, "text": "Your badge\nDuration\nTotal", "fontSize": 9.5, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": false, "index": "a123"},
