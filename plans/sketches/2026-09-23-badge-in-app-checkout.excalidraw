    {"id": "c1-btnt", "type": "text", "x": 86, "y": 2342, "width": 248, "height": 14, "strokeColor": "#ffffff", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["C1", "lane3"], "seed": 3116, "text": "Pay $420.00 with Monero", "fontSize": 11, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "c1-btn", "index": "a21f"},
    {"id": "c1-capt", "type": "text", "x": 60, "y": 2680, "width": 300, "height": 14, "strokeColor": "#1c1e26", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["C1", "lane3"], "seed": 3117, "text": "C1.  The method is chosen here, never in the app", "fontSize": 11, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a21g"},
    {"id": "c1-capb", "type": "text", "x": 60, "y": 2700, "width": 340, "height": 66, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["C1", "lane3"], "seed": 3118, "text": "Settled: the app renders no payment method at all. TODO for\nthe service - getBadgeInvoice takes paymentVia today, and\nwhat it returns is method-specific (a Stripe client_secret, or\nan address and a crypto amount). It has to reserve the\ninvoice and its amount with no method chosen, and attach the\ndestination when the page picks one.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a21h"},

