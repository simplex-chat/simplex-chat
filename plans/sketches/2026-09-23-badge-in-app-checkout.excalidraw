    {"id": "a3-capt", "type": "text", "x": 900, "y": 900, "width": 300, "height": 14, "strokeColor": "#1c1e26", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A3", "lane1"], "seed": 1319, "text": "A3.  BadgesPayView, minus the paying", "fontSize": 11, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a04i"},
    {"id": "a3-capb", "type": "text", "x": 900, "y": 920, "width": 340, "height": 66, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A3", "lane1"], "seed": 1320, "text": "The screen keeps its shape - level name as the title, the\nprofile preview, the tagline, three cards - and loses its\npurpose: Pay $70 becomes Continue, and purchase() moves to\nA4. The cards here are the catalog's offers, 1 / 3 / 12\nprepaid months, rather than BadgePeriod's subscriptions -\nthe one real fork between this lane and the next.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a04j"},

