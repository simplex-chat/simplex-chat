    {
      "id": "o-capb",
      "type": "text",
      "x": 1740,
      "y": 1810,
      "width": 340,
      "height": 66,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "roughness": 0,
      "groupIds": [
        "O",
        "lane2"
      ],
      "seed": 2622,
      "text": "Two of these are states on BadgeState, not alerts: Paid, which\nthe worker retries, and Waiting, which holds nothing but the\nslot - Support SimpleX must not offer a second purchase of a\nconsumable. Both resolve through the store, not the service:\nTransaction.updates on iOS, queryPurchasesAsync on Play,\nwhich is also how each is re-found after a restart.",
      "fontSize": 9,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "index": "a15l",
      "version": 1,
      "versionNonce": 0,
