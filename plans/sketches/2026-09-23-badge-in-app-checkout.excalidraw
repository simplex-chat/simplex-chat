      "groupIds": [
        "C2",
        "lane3"
      ],
      "seed": 3214,
      "text": "It already resumes an order from the server, so an invoice the\napp reserved needs nothing new here. Card is not a hosted\npage - the invoice carries a Stripe client_secret and the page\nrenders Elements - which is the reason no card form can\nmove into the app, whatever else does.",
      "fontSize": 9,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
