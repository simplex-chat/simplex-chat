    {"id": "a6-f2", "type": "text", "x": 2192, "y": 544, "width": 252, "height": 48, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A6", "lane1"], "seed": 1610, "text": "Prepaid months have no billing date.\nThe badge is reissued each month from\nthe balance you already paid for, and\nends when it runs out.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": false, "index": "a079"},
