    {"id": "b3-note", "type": "text", "x": 924, "y": 1336, "width": 252, "height": 26, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B3", "lane2"], "seed": 2307, "text": "Charged by the App Store to the\naccount on this device.", "fontSize": 9.5, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": false, "index": "a136"},
    {"id": "b3-btn", "type": "rectangle", "x": 930, "y": 1590, "width": 240, "height": 38, "strokeColor": "transparent", "backgroundColor": "#5b21b6", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": {"type": 3}, "groupIds": ["B3", "lane2"], "seed": 2308, "boundElements": [{"id": "b3-btnt", "type": "text"}], "index": "a137"},
    {"id": "b3-btnt", "type": "text", "x": 940, "y": 1602, "width": 220, "height": 14, "strokeColor": "#ffffff", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B3", "lane2"], "seed": 2309, "text": "Pay $699.99/year", "fontSize": 11, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "b3-btn", "index": "a138"},
    {"id": "b3-foot", "type": "text", "x": 920, "y": 1676, "width": 260, "height": 13, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B3", "lane2"], "seed": 2310, "text": "Renews on 24 August 2027. Cancel anytime.", "fontSize": 9.5, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a139"},
    {"id": "b3-capt", "type": "text", "x": 900, "y": 1790, "width": 300, "height": 14, "strokeColor": "#5b21b6", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B3", "lane2"], "seed": 2311, "text": "B3.  The same screen, everywhere else", "fontSize": 11, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a13a"},
    {"id": "b3-capb", "type": "text", "x": 900, "y": 1810, "width": 340, "height": 66, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B3", "lane2"], "seed": 2312, "text": "One line removed, and no hint that paying elsewhere exists.\nWorth knowing while deciding this: master already ships an\nunconditional browser link - getCodeButton() on A1 opens\nsimplex.chat/badges in every build, every storefront - so the\nrule this panel obeys is stricter than what is shipping today.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a13b"},

    {"id": "b4-pay", "type": "rectangle", "x": 1320, "y": 1200, "width": 300, "height": 150, "strokeColor": "#5b21b6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": {"type": 3}, "groupIds": ["B4", "lane2"], "seed": 2401, "boundElements": [{"id": "ar-b3b4", "type": "arrow"}, {"id": "ar-b4pc", "type": "arrow"}], "index": "a140"},
    {"id": "b4-payt", "type": "text", "x": 1340, "y": 1218, "width": 260, "height": 18, "strokeColor": "#1c1e26", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4", "lane2"], "seed": 2402, "text": "Paid", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a141"},
    {"id": "b4-pays", "type": "text", "x": 1340, "y": 1248, "width": 260, "height": 13, "strokeColor": "#5b21b6", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4", "lane2"], "seed": 2403, "text": "o  Issuing your badge", "fontSize": 10, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a142"},
    {"id": "b4-payb", "type": "text", "x": 1346, "y": 1278, "width": 248, "height": 39, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4", "lane2"], "seed": 2404, "text": "The store has taken the payment.\nThis keeps trying if you close the\napp, and survives a reinstall.", "fontSize": 9.5, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a143"},
    {"id": "b4-chip", "type": "rectangle", "x": 1320, "y": 1400, "width": 300, "height": 130, "strokeColor": "#8f97a3", "backgroundColor": "#f2f3f5", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": {"type": 3}, "groupIds": ["B4b", "lane2"], "seed": 2405, "boundElements": [{"id": "ar-b4pc", "type": "arrow"}], "index": "a144"},
