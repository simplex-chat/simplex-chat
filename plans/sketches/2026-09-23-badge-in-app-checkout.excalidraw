    {"id": "a4-div", "type": "rectangle", "x": 1344, "y": 426, "width": 252, "height": 1, "strokeColor": "#dfe4ea", "backgroundColor": "#dfe4ea", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": null, "groupIds": ["A4", "lane1"], "seed": 1406, "index": "a055"},
    {"id": "a4-note", "type": "text", "x": 1344, "y": 470, "width": 252, "height": 39, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A4", "lane1"], "seed": 1407, "text": "You choose how to pay in the browser:\ncard, handled by Stripe, or Bitcoin and\nMonero on-chain.", "fontSize": 9.5, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": false, "index": "a056"},
    {"id": "a4-btn", "type": "rectangle", "x": 1350, "y": 730, "width": 240, "height": 38, "strokeColor": "transparent", "backgroundColor": "#0053d0", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": {"type": 3}, "groupIds": ["A4", "lane1"], "seed": 1408, "boundElements": [{"id": "a4-btnt", "type": "text"}], "index": "a057"},
    {"id": "a4-btnt", "type": "text", "x": 1360, "y": 742, "width": 220, "height": 14, "strokeColor": "#ffffff", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A4", "lane1"], "seed": 1409, "text": "Pay $420.00 in the browser", "fontSize": 11, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "a4-btn", "index": "a058"},
    {"id": "a4-foot", "type": "text", "x": 1340, "y": 786, "width": 260, "height": 13, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A4", "lane1"], "seed": 1410, "text": "Ends on 24 August 2027.", "fontSize": 9.5, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a059"},
    {"id": "a4-capt", "type": "text", "x": 1320, "y": 900, "width": 300, "height": 14, "strokeColor": "#0053d0", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A4", "lane1"], "seed": 1411, "text": "A4.  New screen", "fontSize": 11, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a05a"},
    {"id": "a4-capb", "type": "text", "x": 1320, "y": 920, "width": 340, "height": 66, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A4", "lane1"], "seed": 1412, "text": "The rows are the web page's summaryRows, which is where\nthis copy comes from. The total is the amount the reserved\ninvoice carries, never one the app worked out:\ncatalog_changed is not raised when only the amount moves,\nso a client pricing it locally would show a figure the service\nwill not charge.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a05b"},

