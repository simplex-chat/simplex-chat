    {
      "id": "ft-note",
      "type": "text",
      "x": 60,
      "y": 2830,
      "width": 2400,
      "height": 26,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "roughness": 0,
      "groupIds": [
        "footer"
      ],
      "seed": 4005,
      "text": "Copy is quoted from the app and the page. The app's screens take the page's names: Your level becomes Choose your badge, the level name becomes How long?, and Check your order is shared already.\nStore prices are illustrative and come from the storefront; the page's prices are the shipped catalog. Not drawn: the page's refusals - no active price, a provider unavailable, too many attempts - which are unchanged and already built.",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "index": "a300",
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "fillStyle": "solid",
