    {
      "id": "b4-capb",
      "type": "text",
      "x": 2160,
      "y": 1810,
      "width": 340,
      "height": 66,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "roughness": 0,
      "groupIds": [
        "B6",
        "lane2"
      ],
      "seed": 2618,
      "text": ".success is confirmation - Apple signs the transaction and the\nmoney is taken. Issuing is the next event, and the gap between\nthem is what BadgeState has to hold: the same state as A5,\na different funding proof. transaction.finish() must wait for the\ncredential, as BadgeStore's comment says - that is what makes\nthis one recoverable, unlike the alert below it.",
      "fontSize": 9,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "index": "a171",
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "opacity": 100,
      "angle": 0,
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790239746588,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": ".success is confirmation - Apple signs the transaction and the\nmoney is taken. Issuing is the next event, and the gap between\nthem is what BadgeState has to hold: the same state as A5,\na different funding proof. transaction.finish() must wait for the\ncredential, as BadgeStore's comment says - that is what makes\nthis one recoverable, unlike the alert below it.",
      "lineHeight": 1.2222222222222223
    },
