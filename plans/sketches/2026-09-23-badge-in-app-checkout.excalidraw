    {"id": "a5-capt", "type": "text", "x": 1740, "y": 900, "width": 300, "height": 14, "strokeColor": "#0053d0", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A5", "lane1"], "seed": 1510, "text": "A5.  New screen, and new state", "fontSize": 11, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a069"},
    {"id": "a5-capb", "type": "text", "x": 1740, "y": 920, "width": 340, "height": 66, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A5", "lane1"], "seed": 1511, "text": "Reached by leaving A4, and by opening Support SimpleX with\na purchase already in flight - so it is state on BadgeState,\nnot a screen: one profile, surviving a restart, resolving with\nno browser at all. While it holds, neither Support SimpleX nor\nYour badge is the right thing to show, and the chat-list pitch\nbanner stays down.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a06a"},

