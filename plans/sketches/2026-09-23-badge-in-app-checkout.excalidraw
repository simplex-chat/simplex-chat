    {
      "id": "b2-capb",
      "type": "text",
      "x": 1740,
      "y": 1810,
      "width": 340,
      "height": 66,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "roughness": 0,
      "groupIds": [
        "B2",
        "lane2"
      ],
      "seed": 2512,
      "text": "No second button and no mention of paying elsewhere, in any\nstorefront - the browser lives on B2 now, not here, so this\nscreen is identical everywhere and nothing about it is gated.\nThat also removes the awkward part of the earlier draft: a\nsubscription had no web equivalent, and a code bought online\nis prepaid months, which the store path never has to reconcile.",
      "fontSize": 9,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "index": "a15b",
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
