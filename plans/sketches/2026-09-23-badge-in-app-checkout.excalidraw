    {
      "id": "bs3-capb",
      "type": "text",
      "x": 900,
      "y": 1810,
      "width": 340,
      "height": 66,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "roughness": 0,
      "groupIds": [
        "BS3",
        "lane2"
      ],
      "seed": 2315,
      "text": "Nothing here changes, which is the point of routing the store\nbuilds this way: the browser sells a code, the buyer carries it\nback to B2, and none of lane C's reserved invoice is involved.\nThe page tells them Settings -> Supporter perks -> Redeem\ncode, so if B1's label changes that sentence has to change\ntoo.",
      "fontSize": 9,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "index": "a13e",
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "opacity": 100,
      "angle": 0,
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1790239746588,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Nothing here changes, which is the point of routing the store\nbuilds this way: the browser sells a code, the buyer carries it\nback to B2, and none of lane C's reserved invoice is involved.\nThe page tells them Settings -> Supporter perks -> Redeem\ncode, so if B1's label changes that sentence has to change\ntoo.",
      "lineHeight": 1.2222222222222223
