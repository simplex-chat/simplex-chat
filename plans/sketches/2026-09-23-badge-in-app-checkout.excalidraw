    {"id": "a6-capb", "type": "text", "x": 2160, "y": 920, "width": 340, "height": 66, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["A6", "lane1"], "seed": 1614, "text": "Untouched, and reached without a code ever being generated,\nshown or typed - the point of the exercise. One thing does\nbreak: the Ends footer says prepaid months have no billing\ndate, which stops being true for a store subscription, so that\nsection needs a second wording before lane B can land.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a07d"},

