    {"id": "b4-chips", "type": "text", "x": 1340, "y": 1490, "width": 260, "height": 12, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4b", "lane2"], "seed": 2409, "text": "shown on your profile", "fontSize": 9, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a148"},
    {"id": "b4-chipn", "type": "text", "x": 1320, "y": 1544, "width": 300, "height": 12, "strokeColor": "#9aa1ab", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4b", "lane2"], "seed": 2410, "text": "A6, unchanged", "fontSize": 9, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a149"},
    {"id": "b4-alert", "type": "rectangle", "x": 1340, "y": 1590, "width": 260, "height": 150, "strokeColor": "#d6dae0", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": {"type": 3}, "groupIds": ["B4a", "lane2"], "seed": 2411, "boundElements": [{"id": "ar-b3b4a", "type": "arrow"}], "index": "a14a"},
    {"id": "b4-alertt", "type": "text", "x": 1356, "y": 1610, "width": 228, "height": 14, "strokeColor": "#1c1e26", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4a", "lane2"], "seed": 2412, "text": "Waiting for approval", "fontSize": 11, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a14b"},
    {"id": "b4-alertb", "type": "text", "x": 1356, "y": 1636, "width": 228, "height": 48, "strokeColor": "#4b5563", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4a", "lane2"], "seed": 2413, "text": "This purchase has to be approved\non the account that pays for it.\nNothing has been charged, and\nyour badge starts once it is.", "fontSize": 9.5, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a14c"},
    {"id": "b4-alertd", "type": "rectangle", "x": 1340, "y": 1700, "width": 260, "height": 1, "strokeColor": "#dfe4ea", "backgroundColor": "#dfe4ea", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": null, "groupIds": ["B4a", "lane2"], "seed": 2414, "index": "a14d"},
    {"id": "b4-alerto", "type": "text", "x": 1340, "y": 1713, "width": 260, "height": 14, "strokeColor": "#0053d0", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4a", "lane2"], "seed": 2415, "text": "Ok", "fontSize": 11, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a14e"},
    {"id": "b4-alertn", "type": "text", "x": 1320, "y": 1752, "width": 300, "height": 12, "strokeColor": "#9aa1ab", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4a", "lane2"], "seed": 2416, "text": "not a purchase yet - nothing to hold, nothing to retry", "fontSize": 9, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a14f"},
    {"id": "b4-capt", "type": "text", "x": 1320, "y": 1790, "width": 300, "height": 14, "strokeColor": "#5b21b6", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4", "lane2"], "seed": 2417, "text": "B4.  Paid and issued are two events", "fontSize": 11, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a150"},
    {"id": "b4-capb", "type": "text", "x": 1320, "y": 1810, "width": 340, "height": 66, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B4", "lane2"], "seed": 2418, "text": ".success is confirmation - Apple signs the transaction and the\nmoney is taken. Issuing is the next event, a purchaseBadge\nround trip, and the gap between them is what BadgeState has\nto hold: the same state as A5, a different funding proof.\ntransaction.finish() must wait for the credential, as\nBadgeStore's comment already says, and that is what makes\nthis one recoverable - an unfinished transaction is redelivered\non every launch.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a151"},

