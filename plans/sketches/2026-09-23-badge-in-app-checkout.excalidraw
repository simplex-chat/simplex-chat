    {"id": "b1-btn", "type": "rectangle", "x": 90, "y": 1620, "width": 240, "height": 38, "strokeColor": "transparent", "backgroundColor": "#5b21b6", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "roundness": {"type": 3}, "groupIds": ["B1", "lane2"], "seed": 2116, "boundElements": [{"id": "b1-btnt", "type": "text"}], "index": "a11f"},
    {"id": "b1-btnt", "type": "text", "x": 100, "y": 1632, "width": 220, "height": 14, "strokeColor": "#ffffff", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B1", "lane2"], "seed": 2117, "text": "Continue", "fontSize": 11, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "b1-btn", "index": "a11g"},
    {"id": "b1-foot", "type": "text", "x": 80, "y": 1676, "width": 260, "height": 13, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B1", "lane2"], "seed": 2118, "text": "Renews on 24 August 2027. Cancel anytime.", "fontSize": 9.5, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a11h"},
    {"id": "b1-capt", "type": "text", "x": 60, "y": 1790, "width": 300, "height": 14, "strokeColor": "#1c1e26", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B1", "lane2"], "seed": 2119, "text": "B1.  The same view, the store's products", "fontSize": 11, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a11i"},
    {"id": "b1-capb", "type": "text", "x": 60, "y": 1810, "width": 340, "height": 66, "strokeColor": "#6b7280", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B1", "lane2"], "seed": 2120, "text": "BadgePeriod exactly as written today: one-time, monthly,\nannual, six product ids, prices from StoreKit and Play in the\nstorefront's currency. A store build never sends\ngetBadgeCatalog, so these numbers need not match the web\npage's and generally will not.", "fontSize": 9, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "autoResize": true, "index": "a11j"},

    {"id": "b2-panel", "type": "rectangle", "x": 480, "y": 1150, "width": 300, "height": 620, "strokeColor": "#5b21b6", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "roundness": {"type": 3}, "groupIds": ["B2", "lane2"], "seed": 2201, "boundElements": [{"id": "ar-b1b2", "type": "arrow"}, {"id": "ar-b2b3", "type": "arrow"}], "index": "a120"},
