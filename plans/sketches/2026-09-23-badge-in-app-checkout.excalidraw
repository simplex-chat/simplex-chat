    {"id": "b1-c2t", "type": "text", "x": 170, "y": 1440, "width": 79, "height": 39, "strokeColor": "#1c1e26", "backgroundColor": "transparent", "roughness": 0, "groupIds": ["B1", "lane2"], "seed": 2112, "text": "Monthly\n\n$69.99/month", "fontSize": 10, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "autoResize": false, "index": "a11b"},
