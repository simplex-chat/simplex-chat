    {
      "title": "Security",
      "facts": [
        {
          "fact": "End-to-end encryption",
          "value": "double ratchet with post-quantum key exchange (sntrup761) on every ratchet step, on by default in direct conversations",
          "asOf": "since v5.7, April 2024",
          "sources": [{ "title": "Blog", "url": "https://simplex.chat/blog/20240426-simplex-legally-binding-transparency-v5-7-better-user-experience.md" }]
        },
        {
          "fact": "IP address protection",
          "value": "private message routing: 2-hop routing where the sender chooses the forwarding relay and the recipient chooses the destination relay, so neither side observes the other's IP address",
          "asOf": "since v5.8, June 2024",
          "sources": [{ "title": "Blog", "url": "https://simplex.chat/blog/20240604-simplex-chat-v5.8-private-message-routing-chat-themes.md" }]
        },
        {
          "fact": "Implementation security assessment",
          "value": "Trail of Bits",
          "asOf": "October 2022",
          "sources": [
            { "title": "Blog", "url": "https://simplex.chat/blog/20221108-simplex-chat-v4.2-security-audit-new-website.md" },
            { "title": "Report", "url": "https://github.com/simplex-chat/simplex-chat/blob/stable/docs/SimpleX_Chat_Final_Report_11_03_2022.pdf" }
          ]
        },
        {
          "fact": "Cryptographic design review",
          "value": "Trail of Bits",
          "asOf": "July 2024",
          "sources": [
            { "title": "Blog", "url": "https://simplex.chat/blog/20241014-simplex-network-v6-1-security-review-better-calls-user-experience.md" },
            { "title": "Report", "url": "https://github.com/simplex-chat/simplex-chat/blob/stable/docs/SimpleX_Design_Review_2024_Summary_Report_12_08_2024.pdf" }
          ]
        },
        {
          "fact": "Third Trail of Bits audit",
          "value": "completed, to be published",
          "asOf": "2026",
          "sources": [{ "title": "Wefunder memo", "url": "https://simplex.chat/wefunder.md" }]
        },
